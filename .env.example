# Public application
APP_NAME=CyberOps Hub
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000
PHISHING_CAMPAIGN_DAYS=7

# PostgreSQL (use a secret manager in production)
POSTGRES_USER=cyberops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cyberops
DATABASE_URL=postgresql+asyncpg://cyberops:change-me@postgres:5432/cyberops

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=cyberops
MINIO_SECRET_KEY=change-me-too
MINIO_BUCKET=cyberops-evidence
MINIO_SECURE=false

# Fail-closed upload malware scanning (no external port is published)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Cryptography: generate 32-byte urlsafe-base64 keys and RS256 key pairs
JWT_PRIVATE_KEY_PATH=/srv/keys/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=/srv/keys/jwt_public_key.pem
JWT_ISSUER=cyberops-hub
JWT_KEY_ID=development-1
FIELD_ENCRYPTION_KEY=change-this-32-byte-base64-key

# SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=security@cyberops.local
SMTP_TLS=false

# Uploads and execution
MAX_UPLOAD_MB=100
DEFAULT_JOB_TIMEOUT_MINUTES=30
MAX_JOB_TIMEOUT_MINUTES=240
TOOL_DOCKER_NETWORK=cyberops-hub_cyberops-egress
TOOL_OUTPUT_VOLUME=cyberops-hub_scan-output
TOOL_OUTPUT_DIR=/output
MOBSF_API_URL=http://mobsf:8000/api/v1
MOBSF_API_KEY=

# Seed only; never reuse these credentials
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_ADMIN_EMAIL=admin@cyberops.local

# Production TLS routing
DOMAIN=cyberops.example.com
ACME_EMAIL=security-admin@example.com
